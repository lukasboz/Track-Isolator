<Window x:Class="StemSeparator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:StemSeparator.Converters"
        xmlns:views="clr-namespace:StemSeparator.Views"
        mc:Ignorable="d"
        Title="Stem Separator"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="650"
        Background="{StaticResource MainBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,48,32,32" MaxWidth="900" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,48">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" Foreground="{StaticResource PurpleLightBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Stem Separator" Style="{StaticResource AppTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="Separate vocals, drums, bass, and other instruments from any song using AI"
                               Style="{StaticResource SubtitleStyle}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="600" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Starting State -->
                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding CurrentState, Converter={StaticResource StateToVis}, ConverterParameter=Starting}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="48" Foreground="{StaticResource PurpleLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotateStarting" CenterX="24" CenterY="24" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotateStarting"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:1.5"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Error Banner -->
                <Border CornerRadius="8" Margin="0,0,0,16"
                        Padding="24,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="Error">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource ErrorRedBackground}" />
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource ErrorRed}" />
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1</Thickness>
                    </Border.BorderThickness>
                    <StackPanel>
                        <TextBlock Text="Error:" FontWeight="SemiBold" Foreground="#FFfca5a5" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFfca5a5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- File Upload View -->
                <views:FileUploadView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVis}, ConverterParameter='Idle,Error'}" />

                <!-- Processing View -->
                <views:ProcessingView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVis}, ConverterParameter='Uploading,Processing'}" />

                <!-- Stem Player View -->
                <views:StemPlayerView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVis}, ConverterParameter=Ready}" />

                <!-- Footer -->
                <TextBlock Text="Powered by Demucs AI" Style="{StaticResource FooterStyle}" Margin="0,64,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
