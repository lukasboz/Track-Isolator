<UserControl x:Class="StemSeparator.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">
        <Border CornerRadius="12" Padding="48" Background="{StaticResource CardInnerBrush}"
                BorderThickness="2" BorderBrush="{StaticResource BorderGrayBrush}">
            <StackPanel HorizontalAlignment="Center">

                <!-- Spinning Loader -->
                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                           FontSize="56" Foreground="{StaticResource PurpleLightBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:1.2"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

                <!-- Title -->
                <TextBlock Text="Processing Your Track"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Progress Text -->
                <TextBlock Text="{Binding ProgressText}"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Width="360"
                             Height="8"
                             Margin="0,8,0,16" />

                <!-- Duration Hint -->
                <TextBlock Text="This may take 1-3 minutes..."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18" />

                <Button Content="Cancel"
                        Command="{Binding CancelProcessingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />

            </StackPanel>
        </Border>
    </Border>
</UserControl>
