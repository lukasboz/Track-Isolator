<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Gradient -->
    <Color x:Key="BackgroundGradientStart">#FF111827</Color>
    <Color x:Key="BackgroundGradientMid">#FF581c87</Color>
    <Color x:Key="BackgroundGradientEnd">#FF4c1d95</Color>

    <!-- Purple Accent -->
    <Color x:Key="PurpleAccent">#FF9333ea</Color>
    <Color x:Key="PurpleHover">#FF7e22ce</Color>
    <Color x:Key="PurpleLight">#FFc084fc</Color>
    <Color x:Key="PurpleDark">#FF6b21a8</Color>

    <!-- Green Action -->
    <Color x:Key="GreenAction">#FF16a34a</Color>
    <Color x:Key="GreenHover">#FF15803d</Color>

    <!-- Card Backgrounds -->
    <Color x:Key="CardBackground">#801f2937</Color>
    <Color x:Key="CardInner">#80111827</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="TextSecondary">#FF9ca3af</Color>
    <Color x:Key="TextMuted">#FF6b7280</Color>

    <!-- Borders -->
    <Color x:Key="BorderGray">#FF4b5563</Color>
    <Color x:Key="BorderPurple">#FF9333ea</Color>
    <Color x:Key="BorderTransparent">#00000000</Color>

    <!-- Error -->
    <Color x:Key="ErrorRed">#FFef4444</Color>
    <Color x:Key="ErrorRedBackground">#1Aef4444</Color>

    <!-- Stem Colors -->
    <Color x:Key="StemVocals">#FFc084fc</Color>
    <Color x:Key="StemDrums">#FFf97316</Color>
    <Color x:Key="StemBass">#FF22d3ee</Color>
    <Color x:Key="StemOther">#FF4ade80</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="{StaticResource PurpleAccent}" />
    <SolidColorBrush x:Key="PurpleHoverBrush" Color="{StaticResource PurpleHover}" />
    <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLight}" />
    <SolidColorBrush x:Key="GreenActionBrush" Color="{StaticResource GreenAction}" />
    <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHover}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="CardInnerBrush" Color="{StaticResource CardInner}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGray}" />
    <SolidColorBrush x:Key="BorderPurpleBrush" Color="{StaticResource BorderPurple}" />
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}" />

    <!-- Main Background Gradient -->
    <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundGradientStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource BackgroundGradientMid}" Offset="0.5" />
        <GradientStop Color="{StaticResource BackgroundGradientEnd}" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
